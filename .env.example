# All optional. Claim Check runs fully offline with seed data and the rule-based extractor.
# Only used if CLAIM_EXTRACTOR=anthropic (stub adapter, see src/lib/llm/anthropic-extractor.ts)
ANTHROPIC_API_KEY=
CLAIM_EXTRACTOR=rules
# PostHog-shaped analytics wrapper is a no-op unless a key is set
NEXT_PUBLIC_POSTHOG_KEY=
# Supabase repository is documented in supabase/migrations, not wired by default
SUPABASE_URL=
SUPABASE_ANON_KEY=
